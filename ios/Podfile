# Uncomment this line to define a global platform for your project
platform :ios, '15.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def generated_xcode_build_settings_path
  File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
end

def ensure_flutter_generated_config!
  return if File.exist?(generated_xcode_build_settings_path)

  project_root = File.expand_path('..', __dir__)
  commands = []
  if File.exist?(File.join(project_root, '.fvmrc')) ||
     File.exist?(File.join(project_root, '.fvm', 'fvm_config.json'))
    commands << ['fvm', 'flutter', 'pub', 'get']
  end
  commands << ['flutter', 'pub', 'get']

  commands.each do |command|
    puts "Running `#{command.join(' ')}` to generate ios/Flutter/Generated.xcconfig..."
    Dir.chdir(project_root) do
      if system(*command) && File.exist?(generated_xcode_build_settings_path)
        return
      end
    end
  end

  raise "#{generated_xcode_build_settings_path} must exist. Run `fvm flutter pub get` or `flutter pub get` in #{project_root} first."
end

def flutter_root
  ensure_flutter_generated_config!

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.6'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    end
  end
end
